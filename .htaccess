Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Keep the existing frontend endpoint contract while routing API requests to PHP.
RewriteRule ^api(?:/.*)?$ api.php [QSA,L]
RewriteRule ^(?:\.git|data)(?:/|$) - [F,L]

# Never expose configuration, database exports, or source files directly.
<FilesMatch "^(config\.php|config\.sample\.php|database\.sql|server\.js|\.env|\.admin-env)$">
  Require all denied
</FilesMatch>

<FilesMatch "(^|/)(\.git|data)(/|$)">
  Require all denied
</FilesMatch>

# Basic browser hardening for the shared-hosting deployment.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
